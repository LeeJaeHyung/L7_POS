<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.l7pos.l7_pos.controller.MainController"
            styleClass="root-pane">

    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>

            <Label text="L7 POS" styleClass="app-logo"/>
            <Region styleClass="app-header-divider"/>
            <Label text="매장 판매 관리" styleClass="app-header-caption"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6" prefWidth="184" styleClass="side-nav">
            <padding>
                <Insets top="18" right="14" bottom="18" left="14"/>
            </padding>

            <Label text="메뉴" styleClass="side-nav-caption"/>

            <Button fx:id="saleNavButton"
                    text="판매 등록"
                    onAction="#goSale"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button fx:id="salesHistoryNavButton"
                    text="판매 조회"
                    onAction="#goSalesHistory"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button fx:id="productNavButton"
                    text="상품 · 가격 관리"
                    onAction="#goPriceSetting"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="page">
            <VBox alignment="CENTER" spacing="10">
                <Label text="L7 POS" styleClass="page-title"/>
                <Label text="왼쪽 메뉴에서 작업할 화면을 선택하세요." styleClass="page-desc"/>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
