<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.l7pos.l7_pos.controller.MainController">

    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="L7 POS" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" prefWidth="150"
              style="-fx-background-color: #34495e; -fx-padding: 10;">
            <Button text="판매" onAction="#goSale" prefWidth="130"/>
            <Button text="판매 조회" onAction="#goSalesHistory" prefWidth="130"/>
            <Button text="가격 설정" onAction="#goPriceSetting" prefWidth="130"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <Label text="메인 화면"/>
        </StackPane>
    </center>

</BorderPane>