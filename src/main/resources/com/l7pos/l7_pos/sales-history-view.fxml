<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.l7pos.l7_pos.controller.SaleHistoryController"
            styleClass="page">

    <top>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="20" bottom="4" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="3">
                    <Label text="판매 조회" styleClass="page-title"/>
                    <Label text="기간이나 품번으로 찾고, 선택한 판매를 수정하거나 삭제할 수 있습니다."
                           styleClass="page-desc"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="stat-box">
                    <Label text="조회 수량" styleClass="stat-label"/>
                    <Label fx:id="searchTotalQuantityLabel" text="0개" styleClass="stat-value"/>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="stat-box, stat-box-primary">
                    <Label text="조회 금액" styleClass="stat-label"/>
                    <Label fx:id="searchTotalAmountLabel" text="0원" styleClass="stat-value"/>
                </HBox>
            </HBox>

            <VBox spacing="12" styleClass="card">
                <padding>
                    <Insets top="16" right="18" bottom="16" left="18"/>
                </padding>

                <!-- 기간 조회 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="기간" styleClass="field-label" minWidth="34"/>
                    <DatePicker fx:id="startDatePicker" prefWidth="150"/>
                    <Label text="~" styleClass="page-desc"/>
                    <DatePicker fx:id="endDatePicker" prefWidth="150"/>

                    <Button text="기간 조회" onAction="#onSearchByDate" styleClass="primary-button"/>
                    <Button text="전체 조회" onAction="#onReload" styleClass="secondary-button"/>

                    <Region styleClass="tool-divider"/>

                    <Button text="수정 저장" onAction="#onUpdateSale" styleClass="secondary-button"/>
                    <Button text="선택 판매 삭제" onAction="#onDeleteSale" styleClass="danger-button"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="오늘 삭제 내역"
                            onAction="#onShowDeletedToday"
                            styleClass="secondary-button"/>

                    <Button text="오늘 판매 바코드 복사"
                            onAction="#onCopyTodayBarcodeScript"
                            styleClass="ghost-button"/>
                </HBox>

                <Separator/>

                <!-- 품번 조회 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="품번" styleClass="field-label" minWidth="34"/>

                    <TextField fx:id="productCodeSearchField"
                               prefWidth="230"
                               promptText="예: CO2602ST19"
                               styleClass="code-input"/>

                    <Button text="품번 전체 조회"
                            onAction="#onSearchByProductCode"
                            styleClass="primary-button"/>
                    <Button text="품번 기간 조회"
                            onAction="#onSearchByProductCodeInPeriod"
                            styleClass="secondary-button"/>

                    <Label text="컬러 · 사이즈 관계없이 찾습니다" styleClass="page-desc"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="productCodeSummaryLabel" text="" styleClass="result-badge"
                           visible="false" managed="false"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <SplitPane orientation="VERTICAL" dividerPositions="0.45">
            <BorderPane.margin>
                <Insets top="14" right="20" bottom="20" left="20"/>
            </BorderPane.margin>

            <VBox spacing="10" styleClass="card">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <Label text="판매 내역" styleClass="section-title"/>

                <TableView fx:id="saleTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="saleNoColumn" text="판매번호" prefWidth="190"/>
                        <TableColumn fx:id="saleDateColumn" text="판매일자" prefWidth="170"/>
                        <TableColumn fx:id="totalQuantityColumn" text="총 수량" prefWidth="80"/>
                        <TableColumn fx:id="totalAmountColumn" text="총 금액" prefWidth="120"/>
                        <TableColumn fx:id="saleBarcodesColumn" text="바코드" prefWidth="380"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="10" styleClass="card">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="판매 상세" styleClass="section-title"/>

                    <Region styleClass="tool-divider"/>

                    <TextField fx:id="barcodeField"
                               prefWidth="260"
                               promptText="추가할 바코드를 스캔하세요"
                               styleClass="code-input"/>

                    <Button text="품목 추가" onAction="#onAddItem" styleClass="primary-button"/>
                    <Button text="선택 품목 삭제" onAction="#onDeleteItem" styleClass="danger-button"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="stat-box">
                        <Label text="상세 수량" styleClass="stat-label"/>
                        <Label fx:id="detailQuantityLabel" text="0개" styleClass="stat-value"/>
                    </HBox>

                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="stat-box">
                        <Label text="상세 금액" styleClass="stat-label"/>
                        <Label fx:id="detailAmountLabel" text="0원" styleClass="stat-value"/>
                    </HBox>
                </HBox>

                <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="barcodeColumn" text="바코드" prefWidth="190"/>
                        <TableColumn fx:id="productCodeColumn" text="품번" prefWidth="140"/>
                        <TableColumn fx:id="productNameColumn" text="표시명" prefWidth="180"/>
                        <TableColumn fx:id="colorColumn" text="컬러" prefWidth="80"/>
                        <TableColumn fx:id="sizeColumn" text="사이즈" prefWidth="80"/>
                        <TableColumn fx:id="priceColumn" text="단가" prefWidth="120"/>
                        <TableColumn fx:id="amountColumn" text="금액" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

        </SplitPane>
    </center>
</BorderPane>
