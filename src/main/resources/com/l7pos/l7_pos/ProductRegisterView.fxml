<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.l7pos.l7_pos.controller.ProductRegisterController"
            styleClass="page">

    <top>
        <VBox spacing="0">
            <VBox spacing="14">
                <padding>
                    <Insets top="20" right="20" bottom="4" left="20"/>
                </padding>

                <VBox spacing="3">
                    <Label text="상품 · 가격 관리" styleClass="page-title"/>
                    <Label text="상품을 등록하고 판매 가격을 관리합니다." styleClass="page-desc"/>
                </VBox>

                <HBox spacing="10" styleClass="card" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="14" right="18" bottom="14" left="18"/>
                    </padding>

                    <Label text="상품 조회" styleClass="field-label"/>

                    <TextField fx:id="searchField"
                               promptText="상품코드를 입력하세요"
                               styleClass="code-input"
                               prefWidth="260"/>

                    <Button fx:id="searchButton"
                            text="조회"
                            onAction="#onSearch"
                            styleClass="primary-button"/>

                    <Button fx:id="resetButton"
                            text="전체조회"
                            onAction="#onReset"
                            styleClass="secondary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <VBox spacing="16" styleClass="card" prefWidth="340">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="상품 정보 입력" styleClass="section-title"/>
                <Label text="신규 등록 또는 목록의 상품 수정이 가능합니다." styleClass="section-desc"/>

                <Separator/>

                <VBox spacing="8">
                    <Label text="바코드" styleClass="field-label"/>
                    <TextField fx:id="barcodeField"
                               promptText="바코드를 입력 또는 스캔하세요"
                               styleClass="code-input"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="가격" styleClass="field-label"/>
                    <TextField fx:id="priceField"
                               promptText="가격을 입력하세요"/>
                </VBox>

                <HBox spacing="10">
                    <Button fx:id="registerButton"
                            text="상품 등록"
                            onAction="#onSave"
                            styleClass="primary-button"
                            prefHeight="46"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"/>

                    <Button fx:id="cancelEditButton"
                            text="취소"
                            onAction="#onCancelEdit"
                            styleClass="secondary-button"
                            prefHeight="46"
                            visible="false"
                            managed="false"/>
                </HBox>

                <Label fx:id="messageLabel"
                       text="대기 중"
                       styleClass="message-label"/>
            </VBox>

            <VBox spacing="16" styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <HBox.hgrow>
                    <Priority fx:constant="ALWAYS"/>
                </HBox.hgrow>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="등록 상품 목록" styleClass="section-title"/>
                        <Label text="조회, 수정, 삭제를 한 화면에서 처리할 수 있습니다." styleClass="section-desc"/>
                    </VBox>
                </HBox>

                <TableView fx:id="productTable" VBox.vgrow="ALWAYS" >
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="90"/>
                        <TableColumn fx:id="barcodeColumn" text="상품코드" prefWidth="300"/>
                        <TableColumn fx:id="priceColumn" text="가격" prefWidth="180"/>
                        <TableColumn fx:id="actionColumn" text="관리" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

</BorderPane>